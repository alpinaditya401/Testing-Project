# Backend AquaSmart — variabel runtime.
# Di Railway/Render, isi lewat dashboard, JANGAN commit nilainya.

# Wajib saat database masih kosong. Password minimal 12 karakter,
# username [A-Za-z0-9_.-] 3-64 karakter. Tanpa ini, migrasi menolak jalan.
AQUASMART_SEED_USERNAME=
AQUASMART_SEED_PASSWORD=

# Sudah di-set di Dockerfile; timpa hanya kalau perlu.
# AQUASMART_DB_PATH=/data/aquasmart.sqlite
# AQUASMART_SESSION_SECURE=1
# AQUASMART_APP_ENV=production

# JANGAN aktifkan di produksi. Keduanya membuka jalur simulator dan
# antrean hardware yang default-nya mati.
# AQUASMART_SIMULATOR_ENABLED=0
# AQUASMART_HARDWARE_ENABLED=0
