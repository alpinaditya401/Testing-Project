# Repo publik ini hanya memuat deliverable AquaSmart. Ruang kerja lokal berisi
# empat project lain, materi kursus pihak ketiga, modul kampus, dan dokumen yang
# memuat data pribadi orang lain. Semua itu sengaja tidak diterbitkan.
#
# Pola di bawah adalah daftar putih: tolak semuanya lebih dulu, lalu izinkan
# satu per satu. Urutannya penting, karena git tidak bisa mengizinkan kembali
# berkas yang direktori induknya masih tertolak.

/*
!/.gitignore
!/README.md
!/frontend/
!/01_AquaSmart/
!/notebooks/

# Dua berkas ini diminta eksplisit oleh brief Proyek Akhir: repo publik wajib
# memuat sonar-project.properties dan .github/workflows/ci.yml. Keduanya tidak
# memuat rahasia; token SonarQube dibaca dari secret GitHub, bukan dari berkas.
!/.github/
!/sonar-project.properties

# Pernyataan hak cipta. Repo ini publik demi penilaian, bukan demi pemakaian
# ulang, dan LICENSE yang menyatakan batas itu harus ikut terbaca.
!/LICENSE

/01_AquaSmart/*
!/01_AquaSmart/01_Aplikasi-Web/
!/01_AquaSmart/08_Sistem-Cerdas/
/01_AquaSmart/08_Sistem-Cerdas/*
!/01_AquaSmart/08_Sistem-Cerdas/mandiri.py
!/01_AquaSmart/08_Sistem-Cerdas/evaluasi_model.py
!/01_AquaSmart/08_Sistem-Cerdas/build_notebooks_mandiri.py
!/01_AquaSmart/08_Sistem-Cerdas/build_laporan_gabungan.js
!/01_AquaSmart/08_Sistem-Cerdas/export_bukti_mandiri.py
!/01_AquaSmart/08_Sistem-Cerdas/screenshot_mandiri.cjs
!/01_AquaSmart/08_Sistem-Cerdas/README_MANDIRI.md
!/01_AquaSmart/08_Sistem-Cerdas/requirements-mandiri.txt
!/01_AquaSmart/08_Sistem-Cerdas/tugas_mandiri/
/01_AquaSmart/08_Sistem-Cerdas/tugas_mandiri/*.joblib
/01_AquaSmart/08_Sistem-Cerdas/tugas_mandiri/*.zip
/01_AquaSmart/08_Sistem-Cerdas/tugas_mandiri/qa/

# Salinan cadangan proses dan laporan praktikum yang memuat nama serta NIM
# mahasiswa lain. Keduanya bukan bagian deliverable.
/01_AquaSmart/01_Aplikasi-Web/_backup-sebelum-revisi/
/01_AquaSmart/01_Aplikasi-Web/Laporan_Praktikum_Modul_5_6_7/

# ---------- Artefak build ----------
node_modules/
.next/
out/
build/
.vercel
next-env.d.ts
*.tsbuildinfo

# ---------- Rahasia dan basis data lokal ----------
.env
.env.local
.env.*.local
*.local.txt
*.pem
*.key
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.db

# ---------- Cache ----------
__pycache__/
*.py[cod]
*.log
.DS_Store
Thumbs.db

# ---------- Keluaran runtime AquaSmart ----------
/01_AquaSmart/01_Aplikasi-Web/server/data/local-*/
# Keluaran runner test. Sebelumnya menumpuk di 05_Desain-Figma/review-hermes.
/01_AquaSmart/01_Aplikasi-Web/test-output/
