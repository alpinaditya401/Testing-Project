# Layanan AI AquaSmart — variabel runtime. Isi lewat dashboard hosting; JANGAN commit nilainya.

# Kunci untuk backend PHP memanggil /api/predict dan umpan balik. Minimal 16 karakter acak.
# Nilai yang sama diisi di backend PHP sebagai AQUASMART_AI_KEY.
AQUASMART_AI_SERVICE_KEY=
# Kunci pengelola model (latih, aktivasi, rollback). Berbeda dari kunci layanan.
AQUASMART_AI_ADMIN_KEY=

# Lokasi registry.sqlite dan artefak model. Default: ./instance
# AQUASMART_AI_DATA_DIR=/data/ai
# Folder CSV tambahan yang boleh dilatih (nama berkas tanpa .csv menjadi nama dataset).
# AQUASMART_AI_DATASET_DIR=/data/datasets

# Kriteria aktivasi model (FR-20).
# AQUASMART_AI_MIN_MACRO_F1=0.85
# AQUASMART_AI_MIN_RECALL_ALARM=0.95
# AQUASMART_AI_MAX_GAP_VS_RULE=0.03
